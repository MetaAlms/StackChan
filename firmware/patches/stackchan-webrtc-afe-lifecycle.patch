 void AfeAudioProcessor::Start() {
+#if CONFIG_USE_DEVICE_AEC
+    // Stop() has joined the feed/fetch iteration; start a fresh per-run sample.
+    feed_chunks_.store(0, std::memory_order_relaxed);
+    feed_total_us_.store(0, std::memory_order_relaxed);
+    feed_max_us_.store(0, std::memory_order_relaxed);
+    feed_dropped_samples_.store(0, std::memory_order_relaxed);
+    feed_failures_.store(0, std::memory_order_relaxed);
+    max_buffered_samples_.store(0, std::memory_order_relaxed);
+#endif
     xEventGroupSetBits(event_group_, PROCESSOR_RUNNING);
 }
 
 void AfeAudioProcessor::Stop() {
     xEventGroupClearBits(event_group_, PROCESSOR_RUNNING);
 
+    // Consistent order with the processor task: fetch/AFE lock, then buffer.
+    // Wait for the current feed/fetch iteration before clearing or resetting.
+#if CONFIG_STACKCHAN_WEBRTC_M15 || CONFIG_USE_DEVICE_AEC
+    std::lock_guard<std::mutex> fetch_lock(fetch_mutex_);
+#endif
     std::lock_guard<std::mutex> lock(input_buffer_mutex_);
     if (afe_data_ != nullptr) {
+#if CONFIG_STACKCHAN_WEBRTC_M15
+        int result = afe_iface_->reset_buffer(afe_data_);
+        if (result != 1) {
+            reset_failed_.fetch_add(1, std::memory_order_relaxed);
+            ESP_LOGE(TAG, "AFE ring-buffer reset failed: %d", result);
+        }
+#else
         afe_iface_->reset_buffer(afe_data_);
+#endif
     }
     input_buffer_.clear();
+#if CONFIG_STACKCHAN_WEBRTC_M15
+    output_buffer_.clear();
+    is_speaking_ = false;
+#endif
+#if CONFIG_USE_DEVICE_AEC
+    feed_scratch_.clear();
+    {
+        const uint32_t chunks = feed_chunks_.load(std::memory_order_relaxed);
+        const uint32_t total_us = feed_total_us_.load(std::memory_order_relaxed);
+        const uint32_t max_buffered = max_buffered_samples_.load(std::memory_order_relaxed);
+        const uint32_t channels = codec_ != nullptr ? (uint32_t)codec_->input_channels() : 2;
+        const uint32_t max_backlog_ms = channels != 0 ? max_buffered * 1000 / (16000 * channels) : 0;
+        ESP_LOGW(TAG, "AFE feed: chunks=%lu avg_us=%lu max_us=%lu failures=%lu dropped_samples=%lu max_backlog_ms=%lu queue_cap_samples=%u",
+            (unsigned long)chunks, (unsigned long)(chunks ? total_us / chunks : 0),
+            (unsigned long)feed_max_us_.load(std::memory_order_relaxed),
+            (unsigned long)feed_failures_.load(std::memory_order_relaxed),
+            (unsigned long)feed_dropped_samples_.load(std::memory_order_relaxed),
+            (unsigned long)max_backlog_ms, (unsigned)kMaxBufferedSamples);
+    }
+#endif
 }
 
