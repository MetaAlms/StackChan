+size_t AfeAudioProcessor::ProcessPendingFeed() {
+    const size_t chunk_size = feed_chunk_samples_ * codec_->input_channels();
+    if (chunk_size == 0) {
+        return 0;
+    }
+    // One fetch block consumes this many feed chunks (512 / 256 = 2 here).
+    // Feeding exactly one block keeps the FEED ring from being overrun and
+    // matches the AFE's feed:fetch cadence.
+    const size_t chunks_per_fetch = feed_chunks_per_fetch_;
+    const size_t block_size = chunks_per_fetch * chunk_size;
+    {
+        std::lock_guard<std::mutex> lock(input_buffer_mutex_);
+        if (!IsRunning() || input_buffer_.size() < block_size) {
+            return 0;
+        }
+        feed_scratch_.swap(input_buffer_);
+    }
+    size_t offset = 0;
+    size_t processed = 0;
+    while (processed < chunks_per_fetch && feed_scratch_.size() - offset >= chunk_size && IsRunning()) {
+        const int64_t started_us = esp_timer_get_time();
+        const int ret = afe_iface_->feed(afe_data_, feed_scratch_.data() + offset);
+        const uint32_t elapsed_us = (uint32_t)(esp_timer_get_time() - started_us);
+        if (ret <= 0) {
+            feed_failures_.fetch_add(1, std::memory_order_relaxed);
+        }
+        offset += chunk_size;
+        ++processed;
+        feed_chunks_.fetch_add(1, std::memory_order_relaxed);
+        feed_total_us_.fetch_add(elapsed_us, std::memory_order_relaxed);
+        uint32_t previous = feed_max_us_.load(std::memory_order_relaxed);
+        while (elapsed_us > previous &&
+               !feed_max_us_.compare_exchange_weak(previous, elapsed_us, std::memory_order_relaxed)) {}
+    }
+    if (offset < feed_scratch_.size()) {
+        std::lock_guard<std::mutex> lock(input_buffer_mutex_);
+        input_buffer_.insert(input_buffer_.begin(), feed_scratch_.begin() + offset, feed_scratch_.end());
+    }
+    feed_scratch_.clear();
+    // Always let the caller fetch: fetch is the only consumer that drains the
+    // AFE FEED ring, so skipping it after a failed feed would stall capture.
+    return processed;
