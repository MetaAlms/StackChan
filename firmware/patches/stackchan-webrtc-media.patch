+#if CONFIG_STACKCHAN_WEBRTC_M15
+bool AudioService::PushWebRtcPcm(std::vector<int16_t>&& pcm, uint64_t epoch) {
+    if (pcm.empty() || pcm.size() > 2880 || epoch == 0) return false;
+    std::unique_lock<std::mutex> lock(audio_queue_mutex_, std::try_to_lock);
+    if (!lock || service_stopped_ || epoch != webrtc_playback_epoch_.load() ||
+        audio_playback_queue_.size() >= MAX_PLAYBACK_TASKS_IN_QUEUE) return false;
+    auto task = std::make_unique<AudioTask>();
+    task->type = kAudioTaskTypeDecodeToPlaybackQueue;
+    task->timestamp = 0;
+    task->playback_epoch = epoch;
+    task->pcm = std::move(pcm);
+    audio_playback_queue_.push_back(std::move(task));
+    audio_queue_cv_.notify_all();
+    return true;
+}
+
+void AudioService::StopWebRtcPlayback() {
+    // Output never holds queue mutex while taking commit mutex.
+    std::lock_guard<std::mutex> commit(webrtc_output_mutex_);
+    ++webrtc_playback_epoch_;
+    std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+    for (auto it = audio_playback_queue_.begin(); it != audio_playback_queue_.end();) {
+        if ((*it)->playback_epoch != 0) it = audio_playback_queue_.erase(it);
+        else ++it;
+    }
+    audio_queue_cv_.notify_all();
+}
+#endif
