+#if CONFIG_STACKCHAN_WEBRTC_M15
+AudioService::WebRtcPcmAdmission AudioService::PushWebRtcPcm(std::vector<int16_t>&& pcm, uint64_t epoch) {
+    if (pcm.empty() || pcm.size() > 2880 || epoch == 0) return WebRtcPcmAdmission::Invalid;
+    std::unique_lock<std::mutex> lock(audio_queue_mutex_, std::try_to_lock);
+    if (!lock) return WebRtcPcmAdmission::Contended;
+    if (service_stopped_) return WebRtcPcmAdmission::Stopped;
+    if (epoch != webrtc_playback_epoch_.load()) return WebRtcPcmAdmission::Stale;
+    if (audio_playback_queue_.size() >= MAX_PLAYBACK_TASKS_IN_QUEUE) return WebRtcPcmAdmission::Full;
+    auto task = std::make_unique<AudioTask>();
+    task->type = kAudioTaskTypeDecodeToPlaybackQueue;
+    task->timestamp = 0;
+    task->playback_epoch = epoch;
+    task->pcm = std::move(pcm);
+    webrtc_queued_samples_.fetch_add(task->pcm.size());
+    audio_playback_queue_.push_back(std::move(task));
+    audio_queue_cv_.notify_all();
+    return WebRtcPcmAdmission::Accepted;
+}
+
+AudioService::WebRtcPlaybackSnapshot AudioService::GetWebRtcPlaybackSnapshot() const {
+    return {webrtc_queued_samples_.load(), webrtc_inflight_samples_.load(),
+        webrtc_submitted_samples_.load(), webrtc_submitted_calls_.load(),
+        webrtc_last_submit_started_us_.load(), webrtc_last_submit_finished_us_.load(),
+        webrtc_stop_completed_us_.load()};
+}
+
+void AudioService::StopWebRtcPlayback() {
+    // Output never holds queue mutex while taking commit mutex.
+    std::lock_guard<std::mutex> commit(webrtc_output_mutex_);
+    ++webrtc_playback_epoch_;
+    std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+    for (auto it = audio_playback_queue_.begin(); it != audio_playback_queue_.end();) {
+        if ((*it)->playback_epoch != 0) {
+            webrtc_queued_samples_.fetch_sub((*it)->pcm.size());
+            it = audio_playback_queue_.erase(it);
+        }
+        else ++it;
+    }
+    // The commit lock excludes an active OutputData call; the epoch prevents
+    // remaining local PCM from being submitted. Already queued I2S DMA is not
+    // drained or measured here, so this timestamp is not acoustic silence.
+    webrtc_inflight_samples_ = 0;
+    webrtc_stop_completed_us_ = esp_timer_get_time();
+    audio_queue_cv_.notify_all();
+}
+#endif
