     callbacks.on_wake_word_detected = [this](const std::string& wake_word) {
         xEventGroupSetBits(event_group_, MAIN_EVENT_WAKE_WORD_DETECTED);
     };
+    // Tracks how long the current utterance lasted, so a cough or a door slam
+    // does not commit a turn.
+    static int64_t speech_started_us = 0;
+
     callbacks.on_vad_change = [this](bool speaking) {
         xEventGroupSetBits(event_group_, MAIN_EVENT_VAD_CHANGE);
+
+        if (!AliyunOmniProtocol::IsConfigured()) {
+            return;
+        }
+        // The server cannot run VAD on Ogg-framed Opus, so the device ends the
+        // turn itself. Hop to the main task: this callback runs on the audio
+        // task and the commit is a socket write.
+        if (speaking) {
+            speech_started_us = esp_timer_get_time();
+            return;
+        }
+        const int64_t spoken_ms = speech_started_us ? (esp_timer_get_time() - speech_started_us) / 1000 : 0;
+        speech_started_us = 0;
+        if (spoken_ms < 300) {
+            return;
+        }
+        Schedule([this]() {
+            if (auto* aliyun = dynamic_cast<AliyunOmniProtocol*>(protocol_.get())) {
+                aliyun->NotifyLocalSpeechEnded();
+            }
+        });
     };
     audio_service_.SetCallbacks(callbacks);
 
