 void Application::CheckNewVersion() {
+    // When Aliyun is configured the device talks only to Alibaba, so the OTA
+    // activation endpoint must not be contacted at all: it would leak the
+    // device identity to a third party and its websocket config is unused.
+    // The trade-off is losing remote firmware updates; flashing is over USB.
+    if (AliyunOmniProtocol::IsConfigured()) {
+        ESP_LOGI(TAG, "Aliyun mode: skipping OTA version check");
+        return;
+    }
+
     const int MAX_RETRY = 10;
     int retry_count = 0;
     int retry_delay = 10; // Initial retry delay in seconds
@@ -477,7 +488,12 @@ void Application::InitializeProtocol() {
 
     display->SetStatus(Lang::Strings::LOADING_PROTOCOL);
 
-    if (ota_->HasMqttConfig()) {
+    // Aliyun takes priority when credentials are present. It supplies its own
+    // endpoint and auth, so it does not depend on anything the OTA flow returns.
+    if (AliyunOmniProtocol::IsConfigured()) {
+        ESP_LOGI(TAG, "Using Aliyun Qwen-Omni-Realtime protocol");
+        protocol_ = std::make_unique<AliyunOmniProtocol>();
+    } else if (ota_->HasMqttConfig()) {
         protocol_ = std::make_unique<MqttProtocol>();
     } else if (ota_->HasWebsocketConfig()) {
