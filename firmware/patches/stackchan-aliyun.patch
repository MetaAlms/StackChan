+
+    // Opening the audio channel normally needs a screen tap (the avatar panel's
+    // onClick calls ToggleChatState). That is fine for the stock backend, where
+    // the channel is opened lazily per conversation, but it makes the Aliyun
+    // path awkward to verify: reaching the AI.AGENT app leaves the device idle
+    // until someone taps. Start the conversation automatically instead, after a
+    // short pause so the ready sound and UI settle first.
+    if (AliyunOmniProtocol::IsConfigured()) {
+        ESP_LOGI(TAG, "Aliyun mode: starting the conversation automatically");
+        for (int i = 0; i < 3; ++i) {
+            vTaskDelay(pdMS_TO_TICKS(1000));
+        }
+        Schedule([this]() { ToggleChatState(); });
+    }
